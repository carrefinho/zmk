#include <../boards/nordic/nrf54lm20dk/nrf54lm20dk_nrf54lm20a_cpuapp.dts>
#include <dt-bindings/zmk/matrix_transform.h>

/*
 * Hardware available out of the box (from upstream Zephyr DTS):
 *   - LEDs:   led0..led3 (P1.22, P1.25, P1.27, P1.28)
 *   - Buttons: button0..button3 with zephyr,code = INPUT_KEY_0..3,
 *              wired via gpio-keys (input subsystem).
 *   - UART:   uart20 / uart30 at 115200, console on uart20.
 *
 * ZMK consumes the upstream `&buttons` gpio-keys node directly through
 * its post-4.2 input bridge (chosen zmk,matrix-input). A 1x4 transform
 * maps the four push-buttons to keymap positions 0..3.
 *
 * Upstream `nrf54lm20dk_common.dtsi` declares the gpio-keys node as
 * anonymous `buttons {}` with no DT label, so reference by path.
 */

/ {
	chosen {
		zmk,matrix-input = &{/buttons};
		zmk,matrix-transform = &dk_transform;
	};

	dk_transform: dk_transform {
		compatible = "zmk,matrix-transform";
		rows = <1>;
		columns = <4>;
		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3)
		>;
	};
};
