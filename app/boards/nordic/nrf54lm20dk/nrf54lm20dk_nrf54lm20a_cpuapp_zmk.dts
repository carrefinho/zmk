#include <../boards/nordic/nrf54lm20dk/nrf54lm20dk_nrf54lm20a_cpuapp.dts>
#include <behaviors.dtsi>

/*
 * Note: deliberately not including <dt-bindings/zmk/keys.h>. It pulls in
 * `dt-bindings/zmk/hid_usage_pages.h`, which on upstream Zephyr 4.4 fails
 * to preprocess inside this combined overlay (HID_USAGE_KEY tokenization
 * issue). Investigation pending — for milestone #7 (boot + LED + UART)
 * we use raw HID usage codes for the four DK keys.
 *
 * Also not including <dt-bindings/zmk/matrix_transform.h>: its RC(row,col)
 * collides with RC(keycode) (right-control) from modifiers.h. We write
 * the matrix-transform `map` cells as raw `(row << 8) | col` values.
 */

/*
 * Hardware available out of the box (from upstream Zephyr DTS):
 *   - LEDs:   led0..led3 (P1.22, P1.25, P1.27, P1.28)
 *   - Buttons: button0..button3 with zephyr,code = INPUT_KEY_0..3,
 *              wired via gpio-keys (input subsystem).
 *   - UART:   uart20 / uart30 at 115200, console on uart20.
 *
 * ZMK consumes the upstream `&buttons` gpio-keys node directly through
 * its post-4.2 input bridge (chosen zmk,matrix-input). A 1x4 transform
 * maps the four push-buttons to keymap positions 0..3.
 */

/*
 * Upstream `nrf54lm20dk_common.dtsi` declares the gpio-keys node as
 * anonymous `buttons {}` with no DT label. Reference by path in `chosen`.
 */

/ {
	chosen {
		zmk,matrix-input = &{/buttons};
		zmk,matrix-transform = &dk_transform;
	};

	dk_transform: dk_transform {
		compatible = "zmk,matrix-transform";
		rows = <1>;
		columns = <4>;
		map = <
			0x000 0x001 0x002 0x003   /* row 0, cols 0..3 */
		>;
	};

	/*
	 * Inlined keymap. Normally ZMK boards keep the keymap in a separate
	 * `<board>.keymap` discovered by `app/boards/post_boards_shields.cmake`,
	 * but that hook lived in the dropped v4.1.0+zmk-fixes Zephyr fork.
	 * Inlining here gets the DK building on upstream Zephyr 4.4 without
	 * a fresh fork patch. Restore separation when the discovery hook is
	 * re-introduced (TODO).
	 */
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			/*
			 * HID usages: page 0x07 (Keyboard) << 16 | A=0x04, B=0x05,
			 * C=0x06, D=0x07.
			 */
			bindings = <
				&kp 0x70004  /* A */
				&kp 0x70005  /* B */
				&kp 0x70006  /* C */
				&kp 0x70007  /* D */
			>;
		};
	};
};
