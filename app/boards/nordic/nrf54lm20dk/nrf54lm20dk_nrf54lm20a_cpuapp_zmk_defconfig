# Enable MPU + hardware stack protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# nRF54L cache & system counter (mirrors upstream defconfig)
CONFIG_CACHE_MANAGEMENT=y
CONFIG_EXTERNAL_CACHE=y
CONFIG_NRF_GRTC_START_SYSCOUNTER=y

# MPU-based null-pointer detection is not viable on this SoC
CONFIG_NULL_POINTER_EXCEPTION_DETECTION_NONE=y

# The Nordic SoC validate_binding_headers compile re-includes every
# dt-binding header into a single TU; ZMK's `dt-bindings/zmk/keys.h` /
# `hid_usage_pages.h` don't survive that context (root cause TBD,
# tracked as task #13). Disable the check via the v4.4.0+zmk-fixes
# Kconfig option.
CONFIG_NRF_SOC_VALIDATE_HEADERS_DISABLED=y

# GPIO + serial console
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Logging on UART. Minimal mode keeps overhead low.
CONFIG_LOG=y
CONFIG_LOG_MODE_MINIMAL=y
CONFIG_ZMK_LOG_LEVEL_DBG=y

# Input subsystem (replaces kscan in 4.2+)
CONFIG_INPUT=y

# BLE HID (USB HID enabled later via board overlay; nRF54LM20 USBHS = USBD next stack)
CONFIG_ZMK_BLE=y
# CONFIG_ZMK_USB=y  # TODO(#9): enable once USB Device Next port lands

# Settings persistence on RRAM.
# nRF54LM20 RRAM exposes a flash-API shim (compatible = "soc-nv-flash"), so
# NVS technically works, but it does pointless erase-before-write bookkeeping
# on a medium that doesn't need it. ZMS is the right backend for non-flash
# NVMs and Nordic recommends it for nRF54L. The settings subsystem picks
# `SETTINGS_ZMS` automatically when `CONFIG_ZMS=y`.
CONFIG_ZMS=y
CONFIG_SETTINGS_ZMS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
